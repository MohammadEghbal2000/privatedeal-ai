    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kaleidorg/mind": "^0.11.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@qvac/sdk": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
